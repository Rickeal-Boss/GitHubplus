<UserControl x:Class="FastGithub.UI.AcceleratorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="380" d:DesignWidth="600">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 总开关 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="14" Margin="0 0 0 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="加速服务" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="StatusText" Text="状态：检测中…" FontSize="12" Foreground="Gray" Margin="0 4 0 0"/>
                </StackPanel>
                <Button x:Name="ToggleButton" Content="停止加速" Width="110" Height="36"
                        Click="ToggleButton_Click" Grid.Column="1"/>
            </Grid>
        </Border>

        <!-- HuggingFace 加速（仅镜像模式） -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="14" Margin="0 0 0 10">
            <StackPanel>
                <TextBlock Text="HuggingFace 加速" FontSize="14" FontWeight="Bold" Margin="0 0 0 8"/>
                <TextBlock x:Name="HfHint" Text="HuggingFace 采用镜像加速（hf-mirror.com，稳定推荐）。"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 网址清单 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="14" Margin="0 0 0 10">
            <!-- LastChildFill="True"：最后一个子元素 ScrollViewer 填充「标题与风险提示之间」的剩余空间，
                 站点较多时可滚动；风险提示 TextBlock 稳定停靠在底部 -->
            <DockPanel LastChildFill="True">
                <TextBlock Text="加速网址（勾选 = 授权该域名流量被本机 CA 解密）" FontSize="14" FontWeight="Bold"
                           DockPanel.Dock="Top" Margin="0 0 0 4">
                    <TextBlock.ToolTip>
                        <ToolTip Padding="10" FontSize="12" MaxWidth="460">
                            <TextBlock TextWrapping="Wrap" Text="勾选某个站点 = 授权本机自签 CA 解密该域名范围的 HTTPS 流量，再转发到真实服务器。&#x0a;&#x0a;未勾选的站点不走本机 CA（默认绕过）。&#x0a;&#x0a;解密范围取决于勾选站点在 appsettings 片段里声明的域名，可能比站点名称更宽（例如 BootCDN 含 *.cloudflare.com、Microsoft 含 OneDrive 登录域）。&#x0a;&#x0a;把鼠标悬停在下方每个选项上，可查看其加速范围、实现方式与风险说明。"/>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="鼠标悬停每个选项可查看加速范围、实现方式与风险。" FontSize="11" Foreground="Gray"
                           DockPanel.Dock="Top" Margin="0 0 0 8"/>
                <TextBlock x:Name="RiskHintText" DockPanel.Dock="Bottom" Margin="0 8 0 0"
                           FontSize="11" Foreground="#B00020" TextWrapping="Wrap"
                           Text="提示：勾选的站点，其 HTTPS 流量会由本机 CA 解密后转发。"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SitesPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="HintText"
                   Text="提示：修改网址勾选后会自动重启加速引擎以生效（需管理员权限）。"
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>

        <!-- 界面背景：手动导入图片作为 UI 背景；恢复默认即回到原始背景 -->
        <Border Grid.Row="4" Background="White" CornerRadius="6" Padding="14" Margin="0 10 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="界面背景" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="BgPathText" Text="当前：默认背景" FontSize="11" Foreground="Gray"
                               Margin="0 4 0 0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="ChooseBgButton" Content="选择图片…" Width="100" Height="32"
                        Grid.Column="1" Margin="0 0 8 0" Click="ChooseBackground_Click"/>
                <Button x:Name="ResetBgButton" Content="恢复默认" Width="90" Height="32"
                        Grid.Column="2" Click="ResetBackground_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
