{
  // 新增的子配置文件appsettings.*.json，重启应用程序才生效
  "FastGithub": {
    "HttpProxyPort": 38457, // http代理端口，linux/osx平台使用
    "FallbackDns": [ // 以下dns必须要支持tcp
      "119.29.29.29:53",
      "114.114.114.114:53",
      "223.5.5.5:53"
    ],
    "DomainConfigs": {
      "*.fastgithub.com": { // 域名的*表示除.之外0到多个任意字符
        "TlsSni": false, // 指示tls握手时是否发送SNI
        "TlsSniPattern": null, // SNI表达式，@domain变量表示取域名值 @ipaddress变量表示取ip @random变量表示取随机值，其它字符保留不替换
        "TlsIgnoreNameMismatch": false, // 是否忽略服务器证书域名不匹配，当不发送SNI时服务器可能发回域名不匹配的证书，默认为false
        "Timeout": null, // 请求超时时长，格式为"00:02:00"，默认为null
        "IPAddress": null, // 请求的ip，默认为null
        "Destination": null, // 请求目的地，格式为绝对或相对Uri，默认null
        "Response": { // 阻断请求直接响应，设置了Response其它配置都不起作用了
          "StatusCode": 404, // 响应的状态码
          "ContentType": "text/plain;charset=utf-8", // 如果有ContentValue，就要指示ContentType
          "ContentValue": "这是一个用于示范配置的域名" // 自定义返回的内容，这是可选的
        }
      }
    }
  },
  // [PATCH] dnscrypt-proxy 优雅停机与断网看护（改动需重启引擎生效）
  "DnscryptLifecycle": {
    // 单次优雅停机预算（毫秒）。系统给注销/关机的收尾窗口只有几秒，
    // 填得再大也会被夹到 4000 以内，避免「还没停完就被系统强杀」
    "StopBudgetMs": 2500,
    // 进程形态下是否投递软停机信号：auto（默认，仅在引擎独占控制台时启用，
    // 不干扰用户在 cmd/PowerShell 里手跑的场景）/ on（总是尝试）/ off（直接强杀兜底）
    "SoftSignal": "auto",
    // 是否启用「断网优雅停机、网络恢复自动拉起」看护
    "WatchNetwork": true,
    // 看护周期（秒）；接口状态变化事件会把下一轮提前，不必等满一个周期
    "NetworkProbeIntervalSeconds": 15,
    // 连续判定不可用达到该次数才停机（抑制拔网线/切 Wi-Fi/VPN 重连造成的抖动）
    "OfflineConfirmThreshold": 2,
    // 连续判定可用达到该次数才重新启动
    "OnlineConfirmThreshold": 1,
    // 网络恢复后延迟多少秒再拉起（接口 Up 不等于链路可用）
    "RestartDelaySeconds": 3,
    // 判定口径：interfaces（默认，只看有无 Up 且配了网关的接口，零误伤）
    // / probe（再加一轮对 FallbackDns 的 TCP 探测，更贴近真实可用但可能被门户网络误判）
    "NetworkCheck": "interfaces",
    // 单次探测超时（毫秒）
    "NetworkProbeTimeoutMs": 1500,
    // 断网暂停时是否额外清空 DNS 解析缓存。断网期缓存里的 IP 仍是唯一可用信息，默认 false；
    // 改为 true 时暂停瞬间即全清（网络恢复时仍会统一清理空解析，避免命中失效结果）
    "ClearDnsCacheWhenOffline": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // [PATCH] 该 context 的 WRN 是 FallbackDns（223.5.5.5:53 / 119.29.29.29:53）的 TCP 53
        // 被网络过滤产生的噪声（每个 (域名,DNS) 组合每 10 分钟一条），解析实际由内置 dnscrypt 兜底、
        // 0 条非 2xx，确认为纯噪声，故降为 Error 消除刷屏。
        // 排查 DNS 问题时把这一项调回 Warning 即可恢复可见。
        "FastGithub.DomainResolve.DnsClient": "Error",
        "Yarp": "Warning",
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error"
      }
    }
  }
}
